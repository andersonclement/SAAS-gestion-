# ---------------------------------------------------------------------------
# Modèle de configuration pour la PRODUCTION.
#
# Copiez ce fichier en `.env` sur le serveur, remplissez les valeurs marquées
# « À REMPLIR », puis générez la clé applicative :
#
#     php artisan key:generate
#
# Ne versionnez JAMAIS le .env rempli : il contient des secrets.
# ---------------------------------------------------------------------------

APP_NAME="Gestion Stock"
APP_ENV=production
APP_KEY=
# APP_DEBUG=false est impératif : à true, la moindre erreur expose la trace
# complète (chemins serveur, requêtes SQL, parfois des données clients).
APP_DEBUG=false
APP_TIMEZONE=UTC
# À REMPLIR — doit être l'URL publique réelle, en https.
APP_URL=https://exemple.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# --- Reverse proxy / CDN ------------------------------------------------------
# Indispensable si l'application est derrière nginx, un load-balancer ou
# Cloudflare : sans cela l'IP vue est celle du proxy (le blocage
# anti-force-brute regrouperait alors tous les utilisateurs sous une même
# clé, et le journal des connexions serait inexploitable), et le HTTPS
# terminé par le proxy ne serait pas détecté.
#
#   « * »            → proxy sur la même machine, application non joignable
#                      directement depuis l'extérieur (cas le plus courant).
#   « ip1,ip2 »      → liste explicite, à préférer si l'application est
#                      exposée directement (ex. plages Cloudflare).
#   vide             → aucun proxy de confiance.
TRUSTED_PROXIES=*

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# En production on ne journalise pas le niveau debug (volume + fuite de données).
LOG_LEVEL=warning

# --- Base de données ---------------------------------------------------------
# SQLite ne convient pas à une SaaS multi-tenant : verrouillage global en
# écriture, pas de verrous de ligne (donc pas de protection anti-survente),
# et sauvegarde à chaud délicate. MySQL 8+ ou PostgreSQL 14+ requis.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gestion_stock
DB_USERNAME=gestion_stock
# À REMPLIR
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Chiffre le contenu des sessions au repos.
SESSION_ENCRYPT=true
SESSION_PATH=/
# À REMPLIR — le domaine réel, ex. .exemple.com
SESSION_DOMAIN=
# Cookies transmis uniquement en HTTPS et inaccessibles au JavaScript.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# --- E-mail ------------------------------------------------------------------
# Indispensable : sans SMTP fonctionnel, la réinitialisation de mot de passe
# ne peut pas aboutir (les messages partiraient dans les logs).
MAIL_MAILER=smtp
# À REMPLIR
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@exemple.com"
MAIL_FROM_NAME="${APP_NAME}"
